# auto: use PostGIS when reachable, otherwise visibly switch to demo.
# demo: fully offline, no database or provider needed. live: require database.
SMARTFLOW_MODE=auto
APP_ENV=development

# Used only in auto/live mode. Match compose.yaml if using Docker.
# Supply private values locally when using PostGIS.
POSTGRES_PASSWORD=
DATABASE_URL=
DB_MIN_POOL_SIZE=1
DB_MAX_POOL_SIZE=10
DB_COMMAND_TIMEOUT=10
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional external feeds for the standalone ETL scheduler. Leave empty for the offline demo.
TRAFFIC_API_URL=
TRAFFIC_API_KEY=
WEATHER_API_URL=
WEATHER_API_KEY=
INCIDENT_API_URL=
INCIDENT_API_KEY=
CONSTRUCTION_API_URL=
CONSTRUCTION_API_KEY=
